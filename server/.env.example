# Copy to .env on the box. Never commit the real file.
# install.sh generates the token and prints it once.

HERMESNAG_TOKEN=replace-me-with-a-long-random-string
HERMESNAG_DB=/home/ubuntu/apps/hermes-nag/hermesnag.db
HERMESNAG_HOST=127.0.0.1
HERMESNAG_PORT=8787

# Absolute path — hermes is not on PATH for non-interactive shells
HERMES_BIN=/home/ubuntu/.hermes/hermes-agent/venv/bin/hermes

# Client display zone. Storage is always UTC.
HERMESNAG_DISPLAY_TZ=Asia/Kolkata
